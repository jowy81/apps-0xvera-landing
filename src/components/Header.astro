---
import { siteConfig, type Locale } from '@/config/site';
import { t } from '@/config/ui';
import { alternatePath, localizedPath } from '@/lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const home = localizedPath(locale, '/');
const enHref = alternatePath('en', Astro.url.pathname);
const esHref = alternatePath('es', Astro.url.pathname);
---

<a class="skip-link" href="#main">{t(locale, 'nav.skip')}</a>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={home} aria-label={`${siteConfig.name} home`}>0xVera</a>
    <nav class="nav" aria-label={t(locale, 'nav.menu')}>
      <ul class="nav__links">
        <li><a href={`${home}#apps`}>{t(locale, 'nav.apps')}</a></li>
        <li><a href={`${home}#about`}>{t(locale, 'nav.about')}</a></li>
        <li><a href={`${home}#contact`}>{t(locale, 'nav.contact')}</a></li>
      </ul>
      <div class="controls">
        <label class="sr-only" for="language-select">{t(locale, 'lang.label')}</label>
        <select class="control" id="language-select" data-analytics-ignore>
          <option value={enHref} selected={locale === 'en'}>{t(locale, 'lang.en')}</option>
          <option value={esHref} selected={locale === 'es'}>{t(locale, 'lang.es')}</option>
        </select>
        <label class="sr-only" for="theme-select">{t(locale, 'theme.label')}</label>
        <select class="control" id="theme-select">
          <option value="system">{t(locale, 'theme.system')}</option>
          <option value="light">{t(locale, 'theme.light')}</option>
          <option value="dark">{t(locale, 'theme.dark')}</option>
        </select>
      </div>
    </nav>
  </div>
</header>
