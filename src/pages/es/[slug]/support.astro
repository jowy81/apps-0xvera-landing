---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAppSlugs, toPublicSupportPath } from '@/lib/apps';
import { getLegalDoc } from '@/lib/legal';

export async function getStaticPaths() {
  const slugs = await getAppSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const locale = 'es' as const;
const { slug } = Astro.params;
const doc = await getLegalDoc(slug!, 'support', locale);

if (!doc) {
  return Astro.redirect('/es');
}

const { Content } = await render(doc);
const canonicalPath = toPublicSupportPath(slug!, locale);
---

<BaseLayout
  locale={locale}
  title={doc.data.title}
  description={doc.data.description}
  canonicalPath={canonicalPath}
  noindex={doc.data.draft}
>
  <div class="container section">
    <article class="prose panel">
      <Content />
    </article>
  </div>
</BaseLayout>
