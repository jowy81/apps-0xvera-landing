---
import { localeMeta, locales, type Locale } from '@/config/site';
import { t } from '@/config/ui';
import { alternatePath } from '@/lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const current = localeMeta[locale];
const options = locales.map((code) => ({
  code,
  href: alternatePath(code, Astro.url.pathname),
  meta: localeMeta[code],
  current: code === locale,
}));
---

<details class="lang-dropdown" data-lang-dropdown>
  <summary
    class="lang-dropdown__control"
    aria-label={t(locale, 'lang.label')}
    id="language-select"
  >
    <img
      class="lang-dropdown__flag"
      src={current.flag}
      alt=""
      width="20"
      height="14"
      decoding="async"
    />
    <span class="lang-dropdown__current">{current.nativeLabel}</span>
  </summary>
  <ul class="lang-dropdown__menu" role="listbox" aria-labelledby="language-select">
    {
      options.map((option) => (
        <li role="option" aria-selected={option.current ? 'true' : 'false'}>
          <a
            class:list={['lang-dropdown__option', { 'is-current': option.current }]}
            href={option.href}
            hreflang={option.code}
            data-language={option.code}
            aria-current={option.current ? 'true' : undefined}
          >
            <img
              class="lang-dropdown__flag"
              src={option.meta.flag}
              alt=""
              width="20"
              height="14"
              decoding="async"
            />
            <span>{option.meta.nativeLabel}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>
