---
import { localeMeta, locales, type Locale } from '@/config/site';
import { t } from '@/config/ui';
import { alternatePath } from '@/lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const current = localeMeta[locale];
const options = locales.map((code) => ({
  code,
  href: alternatePath(code, Astro.url.pathname),
  meta: localeMeta[code],
  current: code === locale,
}));
---

<div class="lang-dropdown">
  <label class="sr-only" for="language-select">{t(locale, 'lang.label')}</label>
  <div class="lang-dropdown__control">
    <img
      class="lang-dropdown__flag"
      src={current.flag}
      alt=""
      width="20"
      height="14"
      decoding="async"
    />
    <select
      class="lang-dropdown__select"
      id="language-select"
      aria-label={t(locale, 'lang.label')}
      data-analytics-event="language_change"
    >
      {
        options.map((option) => (
          <option value={option.href} selected={option.current} data-language={option.code}>
            {option.meta.nativeLabel}
          </option>
        ))
      }
    </select>
  </div>
</div>
