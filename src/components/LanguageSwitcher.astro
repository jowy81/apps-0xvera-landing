---
import { localeMeta, locales, type Locale } from '@/config/site';
import { t } from '@/config/ui';
import { alternatePath } from '@/lib/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="lang-switch" role="group" aria-label={t(locale, 'lang.label')}>
  {
    locales.map((code) => {
      const href = alternatePath(code, Astro.url.pathname);
      const meta = localeMeta[code];
      const current = code === locale;
      return (
        <a
          class:list={['lang-switch__btn', { 'is-active': current }]}
          href={href}
          hreflang={meta.htmlLang}
          aria-label={meta.nativeLabel}
          aria-current={current ? 'true' : undefined}
          title={meta.nativeLabel}
          data-analytics-event="language_change"
          data-language={code}
        >
          <img
            class="lang-switch__flag"
            src={meta.flag}
            alt=""
            width="22"
            height="16"
            loading="lazy"
            decoding="async"
          />
          <span class="sr-only">{meta.nativeLabel}</span>
        </a>
      );
    })
  }
</div>
