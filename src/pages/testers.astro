---
import TestersSection from '@/components/TestersSection.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/config/ui';

const locale = 'en' as const;
---

<BaseLayout
  locale={locale}
  title={t(locale, 'testers.seoTitle')}
  description={t(locale, 'testers.seoDescription')}
  canonicalPath="/testers"
>
  <TestersSection locale={locale} />
</BaseLayout>
