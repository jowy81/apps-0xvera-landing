---
import type { Locale } from '@/config/site';
import { t } from '@/config/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  aria-label={t(locale, 'theme.toDark')}
  data-label-light={t(locale, 'theme.toLight')}
  data-label-dark={t(locale, 'theme.toDark')}
>
  <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
      <path
        d="M20.5 14.3A7.5 7.5 0 0 1 9.7 3.5 8.5 8.5 0 1 0 20.5 14.3Z"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
  <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path
        d="M12 2.8v2.2M12 19v2.2M2.8 12h2.2M19 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6"
        stroke-linecap="round"></path>
    </svg>
  </span>
</button>
