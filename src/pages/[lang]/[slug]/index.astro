---
import AppDetail from '@/components/AppDetail.astro';
import { isLocale, prefixedLocales, siteConfig, type Locale } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAppBySlug, getAppSlugs, toAppPath } from '@/lib/apps';
import { absoluteUrl, localizedPath } from '@/lib/paths';
import { buildSoftwareApplicationJsonLd } from '@/lib/schema';

export async function getStaticPaths() {
  const slugs = await getAppSlugs();
  return prefixedLocales.flatMap((lang) =>
    slugs.map((slug) => ({
      params: { lang, slug },
    })),
  );
}

const langParam = Astro.params.lang;
const { slug } = Astro.params;

if (!langParam || !isLocale(langParam)) {
  return Astro.redirect(slug ? `/${slug}` : '/');
}

const locale = langParam as Locale;
const app = await getAppBySlug(slug!, locale);

if (!app) {
  return Astro.redirect(localizedPath(locale, '/'));
}

const canonicalPath = toAppPath(app.data.slug, locale);
const pageUrl = absoluteUrl(siteConfig.siteUrl, canonicalPath);
const jsonLd = buildSoftwareApplicationJsonLd(app, locale, siteConfig.siteUrl, pageUrl);
---

<BaseLayout
  locale={locale}
  title={app.data.seoTitle || app.data.name}
  description={app.data.seoDescription || app.data.shortDescription}
  canonicalPath={canonicalPath}
  ogImage={app.data.icon}
  jsonLd={jsonLd}
>
  <div class="container">
    <AppDetail app={app} locale={locale} />
  </div>
</BaseLayout>


